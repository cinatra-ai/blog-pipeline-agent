{
  "name": "@cinatra-ai/blog-pipeline-agent",
  "version": "0.2.2",
  "license": "Apache-2.0",
  "description": "Parent orchestrator (WayFlow Flow OAS) that turns one stored blog idea into a reviewed blog post, its featured image and the LinkedIn post that announces it. Manual brief / reference artifacts input only; transcript input is not accepted. projectId threaded across children. Four HITL pauses of its own: the stored-ideas gate, the brand-voice pick handed down to the writing step, the review the run parks at, and the LinkedIn post; the review DECISION is core's (artifact-lifecycle interception), this flow declares the pause and names the run's own revisions as its targets.",
  "type": "module",
  "files": [
    "cinatra"
  ],
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "Blog Pipeline Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/blog-draft-writer-agent",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "agent"
      },
      {
        "packageName": "@cinatra-ai/blog-idea-generator-agent",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "agent"
      },
      {
        "packageName": "@cinatra-ai/blog-image-generator-agent",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "agent"
      },
      {
        "packageName": "@cinatra-ai/blog-linkedin-writer-agent",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "agent"
      },
      {
        "packageName": "@cinatra-ai/blog-post-artifact",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      },
      {
        "packageName": "@cinatra-ai/blog-idea-artifact",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      },
      {
        "packageName": "@cinatra-ai/blog-image-artifact",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      },
      {
        "packageName": "@cinatra-ai/linkedin-artifacts",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      }
    ],
    "fieldRenderers": [
      {
        "id": "@cinatra-ai/blog-pipeline-agent:idea-selection",
        "kind": "blog-idea-selection",
        "priority": 80,
        "midRunHitl": true
      }
    ],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "blog-pipeline-agent-flow",
    "sourceVersionId": "b214a0a7-9af1-400e-b084-9bd9d99ed575",
    "sourceVersionNumber": 1,
    "type": "flow",
    "riskLevel": "low",
    "hasApprovalGates": true,
    "toolAccess": [],
    "ownerOrgId": null,
    "consumes": [],
    "produces": [
      {
        "extension": "@cinatra-ai/blog-post-artifact",
        "objectTypeId": "@cinatra-ai/blog-post-artifact:post"
      },
      {
        "extension": "@cinatra-ai/linkedin-artifacts",
        "objectTypeId": "@cinatra-ai/linkedin:post-draft"
      }
    ],
    "tools": [
      {
        "name": "stored_ideas",
        "module": "./cinatra/tools/stored-ideas.mjs"
      }
    ],
    "declaredTables": [
      {
        "name": "idea_drafts",
        "organizationColumn": "org_id",
        "runColumn": "run_id",
        "scopeKindColumn": "scope_kind",
        "scopeIdColumn": "scope_id",
        "columns": [
          {
            "name": "org_id",
            "type": "text",
            "notNull": true
          },
          {
            "name": "run_id",
            "type": "text",
            "notNull": true
          },
          {
            "name": "scope_kind",
            "type": "text",
            "notNull": true
          },
          {
            "name": "scope_id",
            "type": "text",
            "notNull": true
          },
          {
            "name": "idea_artifact_id",
            "type": "text",
            "notNull": true
          },
          {
            "name": "idea_revision_id",
            "type": "text",
            "notNull": true
          },
          {
            "name": "state",
            "type": "text",
            "notNull": true
          },
          {
            "name": "draft_artifact_id",
            "type": "text"
          },
          {
            "name": "expires_at",
            "type": "timestamptz"
          },
          {
            "name": "created_at",
            "type": "timestamptz"
          }
        ],
        "indexes": [
          {
            "name": "idea_drafts_one_live",
            "columns": [
              "org_id",
              "idea_artifact_id",
              "state"
            ],
            "unique": true
          },
          {
            "name": "idea_drafts_by_run",
            "columns": [
              "org_id",
              "run_id"
            ]
          },
          {
            "name": "idea_drafts_by_scope",
            "columns": [
              "org_id",
              "scope_kind",
              "scope_id"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "sh -c \"node --test\""
  }
}
